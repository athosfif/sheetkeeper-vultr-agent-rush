# Template only. Do not commit actual credentials.
# Default mode never calls a model or starts cloud resources.
SHEETKEEPER_ENABLE_INFERENCE=0
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=
# Persistent server-private path, writable by the unprivileged controller user.
# Inference fails closed if this path is absent, invalid, or its counter is damaged.
# Reserve before each provider request, including failed requests; never auto-reset.
SHEETKEEPER_INFERENCE_BUDGET_FILE=/var/lib/sheetkeeper/inference-budget.json
SHEETKEEPER_INFERENCE_MAX_CALLS=10
# Allowed 1..500 after reviewing cost; attempts are not a monetary billing meter.
# Declare only after a real deployment; status labels this as server configuration.
SHEETKEEPER_DEPLOYMENT_PROVIDER=
# Required for every API request when binding outside loopback.
SHEETKEEPER_ACCESS_CODE=
SHEETKEEPER_ALLOWED_HOST=
SHEETKEEPER_IMAGE=sheetkeeper-sandbox:prep
